---
import { ACTION_ERROR_CODES } from "astro:actions";
import BaseLayout from "../layouts/BaseLayout.astro";
import activitiesJson from "../data/home/activities.json";
import consortiaJson from "../data/home/consortia.json";
import coordinatorsJson from "../data/home/coordinators.json";
import eventsJson from "../data/home/events.json";
import focusAreasJson from "../data/home/focus-areas.json";
import relatedContextsJson from "../data/home/related-contexts.json";
import servicesJson from "../data/home/services.json";

const awesomeCollectionHref = "#";
const podcastEpisodeHref = "https://shows.acast.com/nfdi-podcast-for-a-fair-data-future/episodes/datenmanagement-in-der-gebauten-umwelt";
const serviceLogo = "/assets/logos/nfdi_only_logo.svg";

type Consortium = {
    name: string;
    image: string;
    href: string;
    hidden?: boolean;
};

type FocusArea = {
    title: string;
    text: string;
};

type Activity = {
    title: string;
    text: string;
};

type Service = {
    title: string;
    text: string;
    href: string;
    label: string;
};

type Coordinator = {
    name: string;
    role: string;
    affiliation: string;
    image: string;
};

type Event = {
    image: string;
    tag: string;
    exactDate: string;
    title: string;
    description: string;
    status: string;
    href?: string;
};

type RelatedContext = {
    name: string;
    text: string;
    image: string;
    href: string;
    hidden?: boolean;
};

const consortia: Consortium[] = consortiaJson;
const focusAreas: FocusArea[] = focusAreasJson;
const activities: Activity[] = activitiesJson;
const services: Service[] = servicesJson;
const coordinators: Coordinator[] = coordinatorsJson;
const events: Event[] = eventsJson;
const relatedContexts: RelatedContext[] = relatedContextsJson;
const visibleEventStatuses = new Set([
    "Registration closed",
    "Upcoming",
    "Open registration",
    "Coming soon"
]);
const visibleEvents = events.filter((event) => visibleEventStatuses.has(event.status));
---

<BaseLayout
        title="AEC in NFDI4ING"
        description="Connecting research practices and infrastructures across the built environment within NFDI4ING."
>
    <section class="hero section">
        <div class="container hero-grid">
            <div class="narrow-flow hero-copy">
                <p class="eyebrow">AEC in NFDI4ING</p>
                <h1>Connecting research practices and infrastructures across the built environment.</h1>
                <p class="lead">
                    AEC in NFDI4ING is a forum for research data management in
                    architecture, engineering, construction, and related fields. AEC in NFDI4ING connects
                    research practices with sustainable, reusable, and open data and software
                    infrastructures.
                </p>
                <div class="action-row">
                    <a class="button button-primary" href="/#contact">
                        Get in touch
                        <svg class="button-icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
                            <path d="M3 5.75A2.75 2.75 0 0 1 5.75 3h12.5A2.75 2.75 0 0 1 21 5.75v12.5A2.75 2.75 0 0 1 18.25 21H5.75A2.75 2.75 0 0 1 3 18.25V5.75Zm2.3.25 6.2 5.17a.8.8 0 0 0 1 0L18.7 6H5.3Zm13.7 1.56-5.22 4.35a2.3 2.3 0 0 1-2.96 0L5 7.56v10.69c0 .41.34.75.75.75h12.5c.41 0 .75-.34.75-.75V7.56Z" fill="currentColor"></path>
                        </svg>
                    </a>
                    <a class="button button-secondary" href="/#events">
                        Events
                        <svg class="button-icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
                            <path d="M7 2a1 1 0 0 1 1 1v1h8V3a1 1 0 1 1 2 0v1h1a3 3 0 0 1 3 3v11a4 4 0 0 1-4 4H6a4 4 0 0 1-4-4V7a3 3 0 0 1 3-3h1V3a1 1 0 0 1 1-1Zm13 8H4v8a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2v-8ZM5 6a1 1 0 0 0-1 1v1h16V7a1 1 0 0 0-1-1H5Z" fill="currentColor"></path>
                        </svg>
                    </a>
                </div>
            </div>
        </div>
    </section>

    <section id="why-it-matters" class="section anchor-section section-divider">
        <div class="container section-stack">
            <div class="section-header">
                <div class="section-heading-block narrow-flow why-block">
                    <p class="eyebrow">Why this matters</p>
                    <h2>Built environment research between practice and infrastructure.</h2>
                    <p class="section-summary">
                        Research on the built environment brings together diverse data related to methods,
                        models, software, drawings, measurements, visual materials, sources and documentation
                        practices. These constellations are shaped by urgent research questions, disciplinary traditions,
                        project contexts, and the material conditions of buildings, sites,
                        infrastructures, and archives.
                    </p>
                    <p class="section-summary">
                        AEC in NFDI4ING works in this space between practice and
                        infrastructure. It supports translating specific research needs into
                        sustainable services, metadata strategies, open workflows, and publication
                        practices within NFDI4ING.
                    </p>
                    <a
                        class="event-link"
                        href={podcastEpisodeHref}
                        target="_blank"
                        rel="noreferrer"
                    >
                        Want to learn more? Listen to the NFDI episode on RDM with Jakob Beetz
                        <svg class="event-link-icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
                            <path d="M14 4a1 1 0 1 0 0 2h2.59l-6.3 6.3a1 1 0 1 0 1.42 1.4L18 7.42V10a1 1 0 1 0 2 0V5a1 1 0 0 0-1-1h-5ZM6 6a2 2 0 0 0-2 2v10a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2v-4a1 1 0 1 0-2 0v4H6V8h4a1 1 0 1 0 0-2H6Z" fill="currentColor"></path>
                        </svg>
                    </a>
                </div>
            </div>

            <div class="card-grid card-grid-3">
                {focusAreas.map((item) => (
                    <article class="card">
                        <h3>{item.title}</h3>
                        <p>{item.text}</p>
                    </article>
                ))}
            </div>
        </div>
    </section>

    <section id="activities" class="section section-soft anchor-section">
        <div class="container section-stack">
            <div class="section-header section-heading-block narrow-flow">
                <p class="eyebrow">How it works</p>
                <h2>Creating a space for exchange, experimentation, and coordination.</h2>
                <p class="section-summary">
                    AEC in NFDI4ING creates a space between research practice and infrastructure. It helps translate recurring needs from built environment research into sustainable support structures within NFDI4ING.
                </p>
            </div>

            <div class="card-grid card-grid-2">
                {activities.map((item) => (
                    <article class="card activity-card">
                        <h3>{item.title}</h3>
                        <p>{item.text}</p>
                    </article>
                ))}
            </div>
        </div>
    </section>

    <section id="services" class="section anchor-section">
        <div class="container section-stack">
            <div class="section-header section-heading-block narrow-flow">
                <p class="eyebrow">What is offered</p>
                <h2>Covering the lifecycle of research data and software.</h2>
                <p class="section-summary">
                    AEC in NFDI4ING connects research questions in architecture, engineering,
                    construction, and the built environment with <a class="link-primary" href="https://nfdi4ing.de/home/25_services/" target="_blank" rel="noreferrer">existing NFDI4ING services</a>. These support different moments in the lifecycle of
                    research data and software: from planning and documentation to computation,
                    publication, archiving, and reuse.
                </p>
            </div>

            <div class="card-grid card-grid-3">
                {services.map((service) => (
                    <article class="card">
                        <img class="service-logo" src={serviceLogo} alt="NFDI" loading="lazy" />
                        <h3>{service.title}</h3>
                        <p>{service.text}</p>
                        {service.href ? (
                            <a class="event-link" href={service.href} target="_blank" rel="noreferrer">
                                {service.label}
                                <svg class="event-link-icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
                                    <path d="M14 4a1 1 0 1 0 0 2h2.59l-6.3 6.3a1 1 0 1 0 1.42 1.4L18 7.42V10a1 1 0 1 0 2 0V5a1 1 0 0 0-1-1h-5ZM6 6a2 2 0 0 0-2 2v10a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2v-4a1 1 0 1 0-2 0v4H6V8h4a1 1 0 1 0 0-2H6Z" fill="currentColor"></path>
                                </svg>
                            </a>
                        ) : null}
                    </article>
                ))}
            </div>

            <a class="event-link" href="https://github.com/Design-Computation-RWTH/AWESOME_NDFI4ING" target="_blank" rel="noreferrer">
                <svg class="event-link-icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
                    <path d="M12 2C6.48 2 2 6.58 2 12.23c0 4.52 2.87 8.35 6.84 9.71.5.1.68-.22.68-.49 0-.24-.01-1.05-.01-1.91-2.78.62-3.37-1.2-3.37-1.2-.45-1.18-1.11-1.49-1.11-1.49-.91-.64.07-.63.07-.63 1 .08 1.53 1.05 1.53 1.05.9 1.56 2.35 1.11 2.92.85.09-.67.35-1.11.63-1.37-2.22-.26-4.56-1.14-4.56-5.09 0-1.13.39-2.05 1.03-2.77-.1-.26-.45-1.32.1-2.75 0 0 .84-.27 2.75 1.06A9.3 9.3 0 0 1 12 6.84c.85 0 1.71.12 2.51.36 1.91-1.33 2.75-1.06 2.75-1.06.55 1.43.2 2.49.1 2.75.64.72 1.03 1.64 1.03 2.77 0 3.96-2.34 4.82-4.57 5.08.36.32.68.95.68 1.92 0 1.39-.01 2.5-.01 2.84 0 .27.18.59.69.49A10.25 10.25 0 0 0 22 12.23C22 6.58 17.52 2 12 2Z" fill="currentColor"></path>
                </svg>
                Explore more tools and services in the AWESOME AEC in NFDI4ING Collection
                <svg class="event-link-icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
                    <path d="M14 4a1 1 0 1 0 0 2h2.59l-6.3 6.3a1 1 0 1 0 1.42 1.4L18 7.42V10a1 1 0 1 0 2 0V5a1 1 0 0 0-1-1h-5ZM6 6a2 2 0 0 0-2 2v10a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2v-4a1 1 0 1 0-2 0v4H6V8h4a1 1 0 1 0 0-2H6Z" fill="currentColor"></path>
                </svg>
            </a>
        </div>
    </section>

    <section id="events" class="section section-soft anchor-section">
        <div class="container section-stack">
            <div class="section-header section-heading-block narrow-flow">
                <p class="eyebrow">Events and activities</p>
                <h2>Engage in exchange around research data management in the built environment.</h2>
                <p class="section-summary">
                    Our activities combine practical training, conceptual discussion, technical exchange,
                    and community building. We organise summer schools, online talks, workshops, discussion events, and community meetings.
                </p>
            </div>

            <div class="event-grid">
                <div class="events-track" data-events-track tabindex="0">
                    {visibleEvents.map((event) => (
                        event.href ? (
                            <a class="event-card event-card-link" href={event.href} target="_blank" rel="noreferrer">
                                <div class="event-image-shell">
                                    <img class="event-image" src={event.image} alt={event.title} loading="lazy" />
                                    <span class="event-image-link-indicator" aria-hidden="true">
                                        <svg viewBox="0 0 24 24" focusable="false">
                                            <path d="M14 4a1 1 0 1 0 0 2h2.59l-6.3 6.3a1 1 0 1 0 1.42 1.4L18 7.42V10a1 1 0 1 0 2 0V5a1 1 0 0 0-1-1h-5ZM6 6a2 2 0 0 0-2 2v10a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2v-4a1 1 0 1 0-2 0v4H6V8h4a1 1 0 1 0 0-2H6Z" fill="currentColor"></path>
                                        </svg>
                                    </span>
                                </div>
                                <div class="event-content">
                                    <p class="event-tag">{event.tag}</p>
                                    <h3>{event.title}</h3>
                                    <p>{event.description}</p>
                                    <div class="event-date-wrap">
                                        <svg class="event-icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
                                            <path d="M7 2a1 1 0 0 1 1 1v1h8V3a1 1 0 1 1 2 0v1h1a3 3 0 0 1 3 3v11a4 4 0 0 1-4 4H6a4 4 0 0 1-4-4V7a3 3 0 0 1 3-3h1V3a1 1 0 0 1 1-1Zm13 8H4v8a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2v-8ZM5 6a1 1 0 0 0-1 1v1h16V7a1 1 0 0 0-1-1H5Z" fill="currentColor"></path>
                                        </svg>
                                        <p class="event-date">{event.exactDate}</p>
                                    </div>
                                </div>
                            </a>
                        ) : (
                            <article class="event-card">
                                <div class="event-image-shell">
                                    <img class="event-image" src={event.image} alt={event.title} loading="lazy" />
                                </div>
                                <div class="event-content">
                                    <p class="event-tag">{event.tag}</p>
                                    <h3>{event.title}</h3>
                                    <p>{event.description}</p>
                                    <div class="event-date-wrap">
                                        <svg class="event-icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
                                            <path d="M7 2a1 1 0 0 1 1 1v1h8V3a1 1 0 1 1 2 0v1h1a3 3 0 0 1 3 3v11a4 4 0 0 1-4 4H6a4 4 0 0 1-4-4V7a3 3 0 0 1 3-3h1V3a1 1 0 0 1 1-1Zm13 8H4v8a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2v-8ZM5 6a1 1 0 0 0-1 1v1h16V7a1 1 0 0 0-1-1H5Z" fill="currentColor"></path>
                                        </svg>
                                        <p class="event-date">{event.exactDate}</p>
                                    </div>
                                </div>
                            </article>
                        )
                    ))}
                </div>
                <div class="events-controls" aria-label="Event navigation">
                    <button class="events-control" type="button" data-events-prev aria-label="Show previous events">
                        <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
                            <path d="M14.7 5.3a1 1 0 0 1 0 1.4L10.41 11H20a1 1 0 1 1 0 2h-9.59l4.29 4.3a1 1 0 1 1-1.4 1.4l-6-6a1 1 0 0 1 0-1.4l6-6a1 1 0 0 1 1.4 0Z" fill="currentColor"></path>
                        </svg>
                    </button>
                    <button class="events-control" type="button" data-events-next aria-label="Show next events">
                        <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
                            <path d="M9.3 18.7a1 1 0 0 1 0-1.4L13.59 13H4a1 1 0 1 1 0-2h9.59L9.3 6.7a1 1 0 0 1 1.4-1.4l6 6a1 1 0 0 1 0 1.4l-6 6a1 1 0 0 1-1.4 0Z" fill="currentColor"></path>
                        </svg>
                    </button>
                </div>
            </div>
        </div>
    </section>

    <script is:inline>
        const eventTrack = document.querySelector('[data-events-track]');
        const prevButton = document.querySelector('[data-events-prev]');
        const nextButton = document.querySelector('[data-events-next]');

        if (
            eventTrack instanceof HTMLElement &&
            prevButton instanceof HTMLButtonElement &&
            nextButton instanceof HTMLButtonElement
        ) {
            const getScrollStep = () => {
                const firstCard = eventTrack.querySelector('.event-card');
                if (!(firstCard instanceof HTMLElement)) {
                    return eventTrack.clientWidth;
                }

                const styles = window.getComputedStyle(eventTrack);
                const gapValue = styles.columnGap !== 'normal' ? styles.columnGap : styles.gap;
                const gap = Number.parseFloat(gapValue) || 0;
                return firstCard.getBoundingClientRect().width + gap;
            };

            const updateControls = () => {
                const hasOverflow = eventTrack.scrollWidth - eventTrack.clientWidth > 4;
                prevButton.disabled = !hasOverflow;
                nextButton.disabled = !hasOverflow;
            };

            prevButton.addEventListener('click', () => {
                const maxScrollLeft = eventTrack.scrollWidth - eventTrack.clientWidth;
                if (maxScrollLeft <= 4) {
                    return;
                }

                if (eventTrack.scrollLeft <= 4) {
                    eventTrack.scrollTo({ left: maxScrollLeft, behavior: 'smooth' });
                    return;
                }

                eventTrack.scrollBy({ left: -getScrollStep(), behavior: 'smooth' });
            });

            nextButton.addEventListener('click', () => {
                const maxScrollLeft = eventTrack.scrollWidth - eventTrack.clientWidth;
                if (maxScrollLeft <= 4) {
                    return;
                }

                if (eventTrack.scrollLeft + eventTrack.clientWidth >= eventTrack.scrollWidth - 4) {
                    eventTrack.scrollTo({ left: 0, behavior: 'smooth' });
                    return;
                }

                eventTrack.scrollBy({ left: getScrollStep(), behavior: 'smooth' });
            });

            eventTrack.addEventListener('scroll', updateControls, { passive: true });
            window.addEventListener('resize', updateControls);
            updateControls();
        }
    </script>

    <section id="about" class="section anchor-section">
        <div id="contexts" class="anchor-offset" aria-hidden="true"></div>
        <div class="container section-stack">
            <div class="section-header section-heading-block narrow-flow">
                <p class="eyebrow">Related Projects</p>
                <h2>Connected research and infrastructure projects.</h2>
                <p class="section-summary">
                    AEC in NFDI4ING links to adjacent initiatives that address climate-neutral construction,
                    computational design, and architectural research data workflows.
                </p>
            </div>

            <div class="card-grid card-grid-3">
                {relatedContexts.filter((context) => !context.hidden).map((context) => (
                    <a class="context-card" href={context.href} target="_blank" rel="noreferrer" aria-label={context.name}>
                        <img class="context-logo" src={context.image} alt={context.name} loading="lazy" />
                    </a>
                ))}
            </div>
        </div>
    </section>

    <section id="exchange" class="section anchor-section">
        <div class="container prose-grid exchange-grid">
            <div class="narrow-flow section-heading-block">
                <p class="eyebrow">Cross-consortial exchange</p>
                <h2>Many questions cross disciplinary boundaries.</h2>
                <p class="section-summary">
                    Research on the built environment is inherently interdisciplinary. Questions of
                    documentation, interpretation, representation, provenance, authority data,
                    visual material, and reuse often emerge across disciplines rather than within a single field.
                </p>
                <p class="section-summary">
                    AEC in NFDI4ING therefore exchanges with related NFDI consortia, particularly
                    <a href="https://nfdi4culture.de/" target="_blank" rel="noreferrer">NFDI4Culture</a>,
                    and <a href="https://www.nfdi4objects.net/" target="_blank" rel="noreferrer">NFDI4Objects</a>
                    to identify shared challenges, compare approaches, and support the transfer
                    of knowledge, methods, and technologies across domains.
                </p>
            </div>

            <div class="logo-showcase">
                {consortia.filter((consortium) => !consortium.hidden).map((consortium) => (
                    <a class="logo-card" href={consortium.href} target="_blank" rel="noreferrer">
                        <img src={consortium.image} alt={consortium.name} loading="lazy" />
                    </a>
                ))}
            </div>
        </div>
    </section>

    <section id="people" class="section anchor-section section-soft">
        <div class="container section-stack">
            <div class="section-header section-heading-block narrow-flow">
                <p class="eyebrow">Who is involved</p>
                <h2>Coordinated between research and infrastructure.</h2>
                <p class="section-summary">
                    AEC in NFDI4ING is coordinated by people working between research and infrastructure.
                    Researchers, developers, infrastructure providers, and projects working on related
                    questions are invited to contribute topics, cases, and experiences.
                </p>
                <p class="section-summary">
                    As the forum is still emerging, additional participants are invited to help shape its
                    direction, activities, and shared concerns.
                </p>
            </div>

            <div class="people-grid">
                {coordinators.map((person) => (
                    <article class="person-card">
                        <div class="person-image-shell">
                            <img class="person-image" src={person.image} alt={person.name} loading="lazy" />
                        </div>
                        <div class="person-copy">
                            <h3>{person.name}</h3>
                            <p class="person-role">{person.role}</p>
                            <p class="person-affiliation">{person.affiliation}</p>
                        </div>
                    </article>
                ))}
            </div>
        </div>
    </section>

    <section id="contact" class="section anchor-section">
        <div class="container contact-cta">
            <div class="narrow-flow section-heading-block">
                <p class="eyebrow">Get in touch</p>
                <h2>Working on built environment research data?</h2>
                <p>
                    We support researchers and projects in developing appropriate RDM strategies,
                    identifying related work, discussing suitable technologies and NFDI services, and
                    preparing data for publication, reuse, and open-science workflows.
                </p>
                <p>
                    You have questions or want to contribute? Drop us a message.
                </p>
            </div>

            <div class="contact-actions">
                <a class="button button-primary" href="mailto:roger.winkler@tu-darmstadt.de">
                    Send an email
                    <svg class="button-icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
                        <path d="M3 5.75A2.75 2.75 0 0 1 5.75 3h12.5A2.75 2.75 0 0 1 21 5.75v12.5A2.75 2.75 0 0 1 18.25 21H5.75A2.75 2.75 0 0 1 3 18.25V5.75Zm2.3.25 6.2 5.17a.8.8 0 0 0 1 0L18.7 6H5.3Zm13.7 1.56-5.22 4.35a2.3 2.3 0 0 1-2.96 0L5 7.56v10.69c0 .41.34.75.75.75h12.5c.41 0 .75-.34.75-.75V7.56Z" fill="currentColor"></path>
                    </svg>
                </a>
                <a class="button button-secondary" href="https://nfdi4ing.de/" target="_blank" rel="noreferrer">
                    Visit NFDI4ING
                    <svg class="button-icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
                        <path d="M14 4a1 1 0 1 0 0 2h2.59l-6.3 6.3a1 1 0 1 0 1.42 1.4L18 7.42V10a1 1 0 1 0 2 0V5a1 1 0 0 0-1-1h-5ZM6 6a2 2 0 0 0-2 2v10a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2v-4a1 1 0 1 0-2 0v4H6V8h4a1 1 0 1 0 0-2H6Z" fill="currentColor"></path>
                    </svg>
                </a>
            </div>
        </div>
    </section>
</BaseLayout>
