---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout
    title="AEC in NFDI4Ing"
    description="Architecture, engineering and construction research data management within NFDI4Ing."
>
    <section class="hero section holding-hero">
        <div class="container hero-grid">
            <div class="narrow-flow hero-copy">
                <p class="eyebrow">AEC IN NFDI4ING</p>
                <h1>
                    Research data management for the built environment,
                    connected across disciplines.
                </h1>
                <p class="lead">
                    We are a community of AEC enthusiasts exploring how research
                    data management can be improved and optimized across the
                    interdisciplinary driven research fields. We bridge
                    knowledge between research and RDM, developing and providing
                    methods, technologies, and guidelines for research.
                </p>
            </div>
        </div>
    </section>
</BaseLayout>
