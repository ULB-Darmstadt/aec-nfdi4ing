---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Page not found | AEC at NFDI4Ing">
  <section class="hero section holding-hero">
    <div class="container hero-grid">
      <div class="narrow-flow hero-copy">
        <p class="eyebrow">404</p>
        <h1>Page not found</h1>
        <p class="lead">
          The requested page does not exist yet or has moved. Return to the landing page to continue.
        </p>
        <div class="action-row">
          <a class="button button-primary" href="/">Back to home</a>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
